[Unit]
Description=Guardian read-only metrics collector
Wants=network-online.target
After=network-online.target
[Service]
Type=simple
User=guardian
Group=guardian
WorkingDirectory=/opt/guardian
EnvironmentFile=/etc/guardian/collector.env
ExecStart=/opt/guardian/.venv/bin/python /opt/guardian/collector/guardian.py --config /etc/guardian/config.json
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
